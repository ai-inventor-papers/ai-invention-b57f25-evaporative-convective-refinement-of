{
  "metadata": {
    "description": "Benchmark dataset of published temperature-time cooling curves for open-surface liquids, selected from educational resources and physics experiments. For comparing Newton's law of cooling against the proposed SCFC model. Contains 5 curves with varying conditions: control, oil film (evaporation minimized), different containers, and time resolutions.",
    "license": "Mixed: CC BY, educational use, open access",
    "version": "1.0",
    "created": "2026-11-25",
    "total_curves": 5,
    "total_examples": 455,
    "selection_criteria": "Max data points, clear provenance, condition variety (oil film, container types), Celsius units, real experimental data"
  },
